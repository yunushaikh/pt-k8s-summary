{{ define "groupedPGClusters" }}
{{ if not .PGEmpty }}
<h2>Percona PostgreSQL clusters (operator CR)</h2>
<p class="meta">{{ .PGMeta }}</p>
<table>
<thead><tr><th>Name</th><th>Endpoint</th><th>Status</th><th>Postgres</th><th>pgBouncer</th><th>CR version</th><th>PG version</th><th>PMM</th><th>Age</th></tr></thead>
<tbody>
{{ range .PGRows }}
<tr>
<td class="pxc-cr-name-cell">{{ if ne .CRYAMLEscaped "" }}<textarea readonly hidden class="pxc-cr-yaml-store" id="{{ .CRYAMLModalID }}-full">{{ .CRYAMLEscaped }}</textarea><button type="button" class="pxc-cr-yaml-btn" data-target="{{ .CRYAMLModalID }}" data-cr-yaml-label="{{ .Namespace }}/{{ .Name }}">{{ .Name }}</button>{{ else }}{{ .Name }}{{ end }}</td>
<td><code>{{ .Endpoint }}</code></td><td>{{ .Status }}</td><td>{{ .PostgresCount }}</td><td>{{ .PGBouncerCount }}</td><td>{{ .CRVersion }}</td><td>{{ .PostgresVersion }}</td><td>{{ .PMMEnabled }}</td><td>{{ .Age }}</td>
</tr>
{{ end }}
</tbody>
</table>
{{ end }}
{{ end }}

{{ define "groupedPGOperator" }}
{{ if .PGOperatorRows }}
<h2>Percona PostgreSQL operator</h2>
<table>
<thead><tr><th>Deployment</th><th>Namespace</th><th>Created</th><th>Operator version</th><th>PGO_WORKERS</th><th>PMM (clusters)</th></tr></thead>
<tbody>
{{ range .PGOperatorRows }}
<tr><td>{{ .Name }}</td><td>{{ .Namespace }}</td><td>{{ .Created }}</td><td>{{ .Version }}</td><td>{{ .Concurrency }}</td><td>{{ .PMMEnabled }}</td></tr>
{{ end }}
</tbody>
</table>
{{ end }}
{{ end }}

{{ define "groupedPGPods" }}
{{ if .PGPodRows }}
<h2>PostgreSQL workload pods</h2>
<table>
<thead><tr><th>Namespace</th><th>Name</th><th>Role</th><th>Ready</th><th>Status</th><th>Restarts</th><th>Age</th><th>IP</th><th>Node</th><th>Image / version</th></tr></thead>
<tbody>
{{ range .PGPodRows }}
<tr><td>{{ .Namespace }}</td><td><code>{{ .Name }}</code></td><td>{{ .Role }}</td><td>{{ .Ready }}</td><td>{{ .Status }}</td><td>{{ .Restarts }}</td><td>{{ .Age }}</td><td>{{ .PodIP }}</td><td>{{ .Node }}</td><td><code>{{ .PostgresVersion }}</code></td></tr>
{{ end }}
</tbody>
</table>
{{ end }}
{{ end }}

{{ define "groupedPGBackups" }}
<h2>Percona PostgreSQL backups</h2>
{{ if .PGBackupEmpty }}
<p class="meta">No <code>PerconaPGBackup</code> resources found.</p>
{{ else }}
<p class="meta">{{ .PGBackupMeta }}</p>
<table>
<thead><tr><th>Name</th><th>Cluster</th><th>Repo</th><th>Destination</th><th>Status</th><th>Type</th><th>Completed</th><th>Age</th></tr></thead>
<tbody>
{{ range .PGBackupRows }}
<tr>
<td class="pxc-cr-name-cell">{{ if ne .BackupYAMLEscaped "" }}<textarea readonly hidden class="pxc-cr-yaml-store" id="{{ .BackupYAMLModalID }}-full">{{ .BackupYAMLEscaped }}</textarea><button type="button" class="pxc-cr-yaml-btn" data-target="{{ .BackupYAMLModalID }}" data-cr-yaml-label="{{ .Namespace }}/{{ .Name }}">{{ .Name }}</button>{{ else }}{{ .Name }}{{ end }}</td>
<td>{{ .Cluster }}</td><td>{{ .Repo }}</td><td>{{ .Destination }}</td><td>{{ .Status }}</td><td>{{ .BackupType }}</td><td>{{ .Completed }}</td><td>{{ .Age }}</td>
</tr>
{{ end }}
</tbody>
</table>
{{ end }}
{{ end }}

