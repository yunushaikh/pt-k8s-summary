<h2>Percona Server for MySQL clusters (operator CR)</h2>
{{ if .PSEmpty }}
<p class="meta">No <code>PerconaServerMySQL</code> resources under <code>{{ .Proc.DumpRootDisplay }}</code> (searched recursively for <code>perconaservermysqls.ps.percona.com.yaml</code> and kind-matched list exports).</p>
{{ else }}
<p class="meta">{{ .PSMeta }} Dump root: <code>{{ .Proc.DumpRootDisplay }}</code> · Pod status and dump log files: see <strong>Percona Server · operator &amp; pod logs</strong> above when present.</p>
<table>
<thead>
<tr>
<th>Cluster</th>
<th>Namespace</th>
<th>CR version</th>
<th>Created</th>
<th>Ready</th>
<th>PMM enabled</th>
<th>Unsafe Flags</th>
<th>Update Strategy</th>
</tr>
</thead>
<tbody>
{{ range .PSRows }}
<tr>
<td class="pxc-cr-name-cell">{{ if ne .CRYAMLEscaped "" }}<textarea readonly hidden class="pxc-cr-yaml-store" id="{{ .CRYAMLModalID }}-full">{{ .CRYAMLEscaped }}</textarea><button type="button" class="pxc-cr-yaml-btn" data-target="{{ .CRYAMLModalID }}" data-cr-yaml-label="{{ .Namespace }}/{{ .Name }}">{{ .Name }}</button>{{ else }}{{ .Name }}{{ end }}</td>
<td>{{ .Namespace }}</td>
<td>{{ .CRVersion }}</td>
<td>{{ .Created }}</td>
<td><span class="{{ .ReadyStatusClass }}">{{ .ReadyStatus }}</span><br><span class="sub sub-ok">Since {{ .ReadySince }}</span></td>
<td>{{ .PMMEnabled }}</td>
<td>{{ if .UnsafeFlagsOK }}<span class="unsafe-flags-ok">NO</span>{{ else }}<span class="unsafe-flags-bad">{{ .UnsafeFlagsEscaped }}</span>{{ end }}</td>
<td>{{ .UpdateStrategy }}</td>
</tr>
<tr><td colspan="{{ $.PSMainColspan }}" class="pxc-comp-wrap">
<h3 class="pxc-subsection-title">Container images vs certified images</h3>
<p class="meta">Compared using <code>spec.crVersion</code> <strong>{{ .CRVersion }}</strong> against the <a href="{{ .CertifiedDocURL }}" target="_blank" rel="noopener noreferrer">Percona certified images</a> list for that operator release.{{ if .CertifiedFetchErrEscaped }}<br><span class="status-bad">{{ .CertifiedFetchErrEscaped }}</span>{{ end }}</p>
<table class="pxc-inner-table">
<thead><tr><th>Image (from <code>pods.yaml</code>)</th><th>Matches certified list</th></tr></thead>
<tbody>
{{ range .ImageCertRows }}<tr><td><code>{{ .ImageEscaped }}</code></td><td>{{ if .IsCertified }}<span class="unsafe-flags-ok">yes</span>{{ else }}<span class="unsafe-flags-bad">no</span>{{ end }}</td></tr>
{{ else }}<tr><td colspan="2" class="status-muted">No container images found for this cluster in <code>pods.yaml</code> (expected <code>app.kubernetes.io/part-of=percona-server</code> and component <code>database</code>, <code>proxy</code>, <code>router</code>, or <code>orchestrator</code>).</td></tr>{{ end }}
</tbody>
</table>
</td></tr>
{{ if $.ShowPSHAProxyCol }}
<tr><td colspan="{{ $.PSMainColspan }}" class="pxc-comp-wrap">
<h3 class="pxc-subsection-title">HAProxy</h3>
<table class="pxc-inner-table">
<thead><tr><th>Size</th><th>Status</th><th>Version</th></tr></thead>
<tbody><tr><td>{{ .HAProxySize }}</td><td>{{ .HAProxyStatus }}</td><td>{{ .HAProxyVersion }}</td></tr></tbody>
</table>
</td></tr>
{{ end }}
{{ if $.ShowPSRouterCol }}
<tr><td colspan="{{ $.PSMainColspan }}" class="pxc-comp-wrap">
<h3 class="pxc-subsection-title">MySQL Router</h3>
<table class="pxc-inner-table">
<thead><tr><th>Size</th><th>Status</th><th>Version</th></tr></thead>
<tbody><tr><td>{{ .RouterSize }}</td><td>{{ .RouterStatus }}</td><td>{{ .RouterVersion }}</td></tr></tbody>
</table>
</td></tr>
{{ end }}
{{ if $.ShowPSOrchestratorCol }}
<tr><td colspan="{{ $.PSMainColspan }}" class="pxc-comp-wrap">
<h3 class="pxc-subsection-title">Orchestrator</h3>
<table class="pxc-inner-table">
<thead><tr><th>Size</th><th>Status</th><th>Version</th></tr></thead>
<tbody><tr><td>{{ .OrchestratorSize }}</td><td>{{ .OrchestratorStatus }}</td><td>{{ .OrchestratorVersion }}</td></tr></tbody>
</table>
</td></tr>
{{ end }}
<tr><td colspan="{{ $.PSMainColspan }}" class="pxc-comp-wrap">
<h3 class="pxc-subsection-title">MySQL</h3>
<table class="pxc-inner-table">
<thead><tr><th>Size</th><th>Status</th><th>Version</th><th>Cluster type</th><th>MySQL <code>configuration</code></th></tr></thead>
<tbody><tr><td>{{ .MySQLSize }}</td><td>{{ .MySQLStatus }}</td><td>{{ .MySQLVersion }}</td><td>{{ .MySQLClusterType }}</td><td class="pxc-cfg-cell"><pre class="pxc-cfg-snippet">{{ .MySQLConfigSnippet }}</pre>{{ if ne .MySQLConfigFullEscaped "" }}<textarea readonly hidden class="pxc-cfg-full-store" id="{{ .MySQLConfigModalID }}-full">{{ .MySQLConfigFullEscaped }}</textarea><div class="pxc-cfg-openwrap"><button type="button" class="pxc-cfg-btn" data-target="{{ .MySQLConfigModalID }}">{{ if .MySQLConfigTruncated }}Show full configuration{{ else }}View MySQL configuration{{ end }}</button></div>{{ end }}</td></tr></tbody>
</table>
</td></tr>
{{ end }}
</tbody>
</table>
{{ end }}

<h2>Percona Server for MySQL backups</h2>
{{ if .PSBackupEmpty }}
<p class="meta">No <code>PerconaServerMySQLBackup</code> resources under <code>{{ .Proc.DumpRootDisplay }}</code> (searched recursively for <code>perconaservermysqlbackups.ps.percona.com.yaml</code> and kind-matched list exports).</p>
{{ else }}
<p class="meta">{{ .PSBackupMeta }} Filter matches name, cluster, storage, destination, status, and age only (not backup log content).</p>
<details class="nodes-coll" id="ps-backups-coll">
<summary class="nodes-coll-sum" aria-label="Expand or collapse the backups table"><span class="nodes-coll-exp" aria-hidden="true"></span><span class="nodes-coll-sum-body"><strong class="nodes-coll-sum-h">Backup inventory</strong><span class="nodes-coll-sum-meta">{{ len .PSBackupRows }} {{ if eq (len .PSBackupRows) 1 }}backup{{ else }}backups{{ end }} · filterable · collapsed by default</span></span></summary>
<div class="nodes-coll-inner">
<div class="report-tbl-toolbar"><label>Filter <input type="search" class="report-tbl-filter" id="ps-backup-filter" placeholder="e.g. Failed, cluster name, storage…" autocomplete="off" spellcheck="false"></label><span class="report-tbl-meta" id="ps-backup-visible"></span></div>
<div class="report-tbl-scroll">
<table class="pxc-backup-table">
<thead>
<tr>
<th>Name</th>
<th class="pxc-backup-log-col">Logs</th>
<th>Cluster</th>
<th>Storage</th>
<th>Destination</th>
<th>Status</th>
<th>Age</th>
</tr>
</thead>
<tbody class="ps-backup-tbody">
{{ range .PSBackupRows }}
<tr class="pxc-backup-row" data-backup-status="{{ .Status }}">
<td class="pxc-backup-col pxc-pod-name-cell"><button type="button" class="pod-name-btn backup-manifest-btn" data-target="{{ .BackupManifestModalID }}" data-backup-display="{{ .Namespace }}/{{ .Name }}">{{ .Name }}</button></td>
<td class="pxc-backup-log-col pxc-pod-log-cell">{{ if .HasPodLog }}<button type="button" class="pod-log-btn" data-target="{{ .PodLogModalID }}" data-pod-name="{{ .LogPodName }}">View logs</button>{{ else }}<span class="status-muted" title="{{ if .LogPodName }}No logs.txt for pod {{ .LogPodName }}{{ else }}No backup pod matched in pods.yaml{{ end }}">—</span>{{ end }}</td>
<td class="pxc-backup-col">{{ .Cluster }}</td>
<td class="pxc-backup-col">{{ .Storage }}</td>
<td class="pxc-backup-col">{{ .Destination }}</td>
<td class="pxc-backup-col pxc-backup-status">{{ .Status }}</td>
<td class="pxc-backup-col">{{ .Age }}</td>
</tr>
{{ end }}
</tbody>
</table>
</div>
<div class="pxc-backup-stash" hidden aria-hidden="true">
{{ range .PSBackupRows }}
<textarea readonly class="backup-manifest-store" id="{{ .BackupManifestModalID }}-full">{{ .BackupManifestEscaped }}</textarea>
{{ if .HasPodLog }}<textarea readonly class="pod-log-store" id="{{ .PodLogModalID }}-full">{{ .PodLogEscaped }}</textarea>{{ end }}
{{ end }}
</div>
</div>
</details>
<script>(function(){
  var sec=document.getElementById("ps-backups-coll");
  if(!sec)return;
  var inp=sec.querySelector("#ps-backup-filter");
  var tbody=sec.querySelector(".ps-backup-tbody");
  var vis=sec.querySelector("#ps-backup-visible");
  if(!inp||!tbody)return;
  var total=tbody.querySelectorAll("tr.pxc-backup-row").length;
  function updateCount(n){
    if(vis) vis.textContent=n===total ? total+" shown" : n+" of "+total+" shown";
  }
  updateCount(total);
  function backupRowHaystack(tr){
    var parts=[];
    tr.querySelectorAll("td.pxc-backup-col").forEach(function(td){
      var c=td.cloneNode(true);
      c.querySelectorAll("textarea").forEach(function(t){ t.remove(); });
      parts.push(c.textContent.trim());
    });
    return parts.join(" ").toLowerCase().replace(/\s+/g," ");
  }
  inp.addEventListener("input", function(){
    var q=inp.value.trim().toLowerCase();
    var n=0;
    tbody.querySelectorAll("tr.pxc-backup-row").forEach(function(tr){
      var show=false;
      if(q===""){
        show=true;
      }else{
        var status=(tr.getAttribute("data-backup-status")||"").toLowerCase();
        if(status.indexOf(q)>=0){
          show=true;
        }else if(backupRowHaystack(tr).indexOf(q)>=0){
          show=true;
        }
      }
      tr.style.display=show?"":"none";
      if(show) n++;
    });
    updateCount(n);
  });
})();</script>
{{ end }}

